#include <windows.h>
#include "resource.h"

/* Native settings dialog. Units are dialog units. */
IDD_SETTINGS DIALOGEX 0, 0, 300, 426
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Fun Plugin - Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    /* ---- Random Move group ---- */
    GROUPBOX        "Random Move", IDC_LBL_MOVE, 7, 5, 286, 114

    LTEXT           "Seconds between moves (e.g. 0.05 = very fast):", -1, 16, 22, 160, 10
    EDITTEXT        IDC_MOVE_INTERVAL, 178, 20, 40, 12, ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT           "When no channel is empty:", -1, 16, 40, 120, 10
    AUTORADIOBUTTON "Ask me each time",          IDC_NE_ASK,  20, 52, 130, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Use ALL channels",          IDC_NE_ALL,  20, 63, 130, 10
    AUTORADIOBUTTON "Skip until one frees up",   IDC_NE_SKIP, 20, 74, 130, 10
    AUTOCHECKBOX    "Make my own channels to move them among (deleted on Stop):", IDC_AUTOCREATE, 20, 88, 260, 10, WS_GROUP
    LTEXT           "count:", -1, 30, 102, 24, 10
    EDITTEXT        IDC_TEMP_COUNT, 56, 100, 26, 12, ES_NUMBER | WS_TABSTOP
    LTEXT           "named:", -1, 90, 102, 26, 10
    EDITTEXT        IDC_TEMP_NAME, 118, 100, 100, 12, ES_AUTOHSCROLL | WS_TABSTOP

    /* ---- Poke group ---- */
    GROUPBOX        "Poke", IDC_LBL_POKE, 7, 124, 286, 152

    LTEXT           "Seconds between pokes (e.g. 0.05 = very fast):", -1, 16, 141, 160, 10
    EDITTEXT        IDC_POKE_DELAY, 178, 139, 40, 12, ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT           "Message:", -1, 16, 158, 60, 10
    AUTORADIOBUTTON "Custom message",           IDC_PM_CUSTOM,    20, 170, 120, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Random message from list",  IDC_PM_RANDOM,    20, 181, 120, 10
    AUTORADIOBUTTON "Random letters/numbers, length:", IDC_PM_RANDCHARS, 20, 192, 145, 10
    EDITTEXT        IDC_RANDLEN, 168, 191, 30, 12, ES_NUMBER | WS_TABSTOP

    LTEXT           "Custom message:", -1, 16, 208, 100, 10, WS_GROUP
    EDITTEXT        IDC_CUSTOMMSG, 16, 219, 270, 12, ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT           "Random messages (one per line):", -1, 16, 236, 150, 10
    EDITTEXT        IDC_RANDOMMSGS, 16, 247, 270, 24,
                    ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP

    /* ---- Reactions group ---- */
    GROUPBOX        "Reactions", IDC_LBL_REACT, 7, 281, 286, 90
    AUTOCHECKBOX    "Auto-poke-back when someone pokes me", IDC_AUTOPOKEBACK, 16, 295, 175, 10, WS_GROUP
    LTEXT           "times:", -1, 196, 295, 24, 10
    EDITTEXT        IDC_APB_TIMES, 222, 293, 30, 12, ES_NUMBER | WS_TABSTOP
    LTEXT           "Talk-poke: pokes each time they talk:", -1, 16, 311, 140, 10
    EDITTEXT        IDC_TALK_TIMES, 160, 309, 30, 12, ES_NUMBER | WS_TABSTOP
    LTEXT           "Talk reaction delay (seconds, e.g. 1; 0 = instant):", -1, 16, 327, 175, 10
    EDITTEXT        IDC_TALK_DELAY, 200, 325, 40, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Talk-poke message (blank = use Poke settings above):", -1, 16, 343, 210, 10
    EDITTEXT        IDC_TALK_MSG, 16, 354, 270, 12, ES_AUTOHSCROLL | WS_TABSTOP

    /* ---- Limiter (applies to Move, Poke and Chaos) ---- */
    GROUPBOX        "Limiter", IDC_LBL_GLOBAL, 7, 375, 286, 26
    LTEXT           "Auto-stop after (seconds, 0 = no limit):", -1, 16, 387, 150, 10
    EDITTEXT        IDC_LIMITER, 200, 385, 45, 12, ES_NUMBER | WS_TABSTOP

    /* ---- Buttons ---- */
    DEFPUSHBUTTON   "OK",     IDOK,     182, 405, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 240, 405, 50, 14
END

IDD_TALKBACK DIALOGEX 0, 0, 300, 164
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Fun Plugin - Talk Back"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Whisper back to:", IDC_TB_LABEL, 12, 12, 70, 10
    LTEXT           "", IDC_TB_TARGET, 86, 12, 200, 18, SS_NOPREFIX
    AUTORADIOBUTTON "Pitch down (deep)", IDC_TB_DOWN, 12, 38, 125, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Pitch up (high)", IDC_TB_UP, 155, 38, 125, 10
    LTEXT           "Pitch amount (1-12 semitones):", -1, 12, 59, 170, 10
    EDITTEXT        IDC_TB_STRENGTH, 200, 57, 50, 14, ES_NUMBER | WS_TABSTOP
    LTEXT           "Echo volume (10-100%):", -1, 12, 81, 170, 10
    EDITTEXT        IDC_TB_VOLUME, 200, 79, 50, 14, ES_NUMBER | WS_TABSTOP
    LTEXT           "Live pitched whisper through your current user.\nYour microphone is replaced by the echo until Stop.\nOnly the selected person hears the echo. No extra tab.", IDC_TB_HELP, 12, 103, 274, 30
    DEFPUSHBUTTON   "Start Talk Back", IDOK, 145, 140, 80, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 231, 140, 55, 14
END

IDD_COPIES DIALOGEX 0, 0, 300, 164
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Fun Plugin - Make copies of myself"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Join channel:", -1, 12, 12, 60, 10
    LTEXT           "", IDC_COPY_CHANNEL, 76, 12, 210, 20, SS_NOPREFIX
    LTEXT           "Extra copies:", -1, 12, 38, 80, 10
    EDITTEXT        IDC_COPY_COUNT, 100, 36, 65, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Nickname prefix:", -1, 12, 60, 80, 10
    EDITTEXT        IDC_COPY_NICKNAME, 100, 58, 186, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Channel password:", -1, 12, 82, 85, 10
    EDITTEXT        IDC_COPY_PASSWORD, 100, 80, 186, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Copies join without microphone or playback. Server limits apply.\nRemove my copies disconnects them and closes their tabs.", -1, 12, 104, 274, 24
    DEFPUSHBUTTON   "Join copies", IDOK, 160, 140, 65, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 231, 140, 55, 14
END
